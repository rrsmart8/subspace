# Alpaca market-data credentials (server-side only — never exposed to the browser).
# Create keys at https://app.alpaca.markets (paper account is fine; the free "iex"
# feed works with paper keys). Copy this file to ".env" and fill in your keys.
#
# When these are absent, the Investments tab falls back to static demo prices,
# so the app and tests still run without any Alpaca account.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional tuning:
# Market-data feed: "iex" (free) or "sip" (paid subscription). Default: iex
# ALPACA_DATA_FEED=iex
# USD -> RON conversion applied to Alpaca's USD prices. Default: 4.57
# ALPACA_USD_TO_RON=4.57
# Server-side per-symbol quote cache in milliseconds. Default: 10000
# ALPACA_CACHE_MS=10000
# How long to cache the tradable-asset list for search, in ms. Default: 21600000 (6h)
# ALPACA_ASSETS_TTL_MS=21600000
# Set to 1 to force static demo prices even when keys are present (tests use this).
# ALPACA_DISABLE=0

# Market-data feed for the assistant's price-history tool: "sip" (all exchanges,
# free on the Basic plan for data older than 15 minutes) or "iex". Default: sip
# (falls back to ALPACA_DATA_FEED automatically if SIP is refused).
# ALPACA_HISTORY_FEED=sip

# ---------------------------------------------------------------------------
# Tier 3 investment assistant (Featherless.ai). Server-side only.
# Without a key the chat endpoint answers 503 and the rest of the app works.
# Get a key at https://featherless.ai/account/api-keys
FEATHERLESS_API_KEY=
# Model with native tool calling (Kimi K2 or the Qwen 3 family). Default below.
# FEATHERLESS_MODEL=moonshotai/Kimi-K2-Instruct
# Per-request timeout in ms. Default: 90000
# FEATHERLESS_TIMEOUT_MS=90000
# Path to the uv binary used to start the market-data MCP server. Default: uv
# CHATBOT_UV_BIN=uv
