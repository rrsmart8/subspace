# Alpaca market-data credentials (server-side only — never exposed to the browser).
# Create keys at https://app.alpaca.markets (paper account is fine; the free "iex"
# feed works with paper keys). Copy this file to ".env" and fill in your keys.
#
# When these are absent, the Investments tab falls back to static demo prices,
# so the app and tests still run without any Alpaca account.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional tuning:
# Market-data feed: "iex" (free) or "sip" (paid subscription). Default: iex
# ALPACA_DATA_FEED=iex
# USD -> RON conversion applied to Alpaca's USD prices. Default: 4.57
# ALPACA_USD_TO_RON=4.57
# Server-side per-symbol quote cache in milliseconds. Default: 10000
# ALPACA_CACHE_MS=10000
# How long to cache the tradable-asset list for search, in ms. Default: 21600000 (6h)
# ALPACA_ASSETS_TTL_MS=21600000
# Set to 1 to force static demo prices even when keys are present (tests use this).
# ALPACA_DISABLE=0
